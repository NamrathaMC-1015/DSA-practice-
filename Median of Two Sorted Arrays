4. Median of Two Sorted Arrays[LEETCODE]

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    int resSize=nums1Size+nums2Size;
    int res[resSize];

    int i=0;int j=0;int k=0;

    while(i<nums1Size&&j<nums2Size){
        if(nums1[i]<nums2[j]){
            res[k]=nums1[i];
            i++;
        }
        else{
            res[k]=nums2[j];
            j++;
        }
        k++;
    }
    while(i<nums1Size){
        res[k]=nums1[i];
        i++;
        k++;
    }
    while(j<nums2Size){
        res[k]=nums2[j];
        j++;
        k++;
    }
    int sum=0;
    for(int i =0;i<resSize;i++){
        sum =sum + res[i];
    }
    if(resSize%2!=0){
        return res[resSize/2];
    }
    else{
        return (res[(resSize/2)-1]+res[resSize/2])/2.0;
    }
}
